{
  "name": "dsh-purge",
  "version": "1.2.5",
  "description": "自用攻防测试工具 · 网络安全检查：DeepSeek Harness 插件，提供安全监察面板、红队演练台与按模型切换的提示词规则，只用于本人环境与授权范围。Self-use attack/defense testing tool for checking network security. 原作者 YuJunZhiXue；y2ambition-ai 维护。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check": "node bin/dsh-purge.js --check",
    "check:prompt": "node --test scripts/check-prompt.mjs",
    "check:runtime": "node --test scripts/check-runtime.mjs",
    "check:desktop": "node --test scripts/check-desktop.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y2ambition-ai/dsh-purge.git"
  },
  "homepage": "https://github.com/y2ambition-ai/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/y2ambition-ai/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/y2ambition-ai/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/y2ambition-ai/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/y2ambition-ai/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "maintainers": [
    {
      "name": "y2ambition-ai"
    }
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "dshElectronTarget": "44.7.0"
}
